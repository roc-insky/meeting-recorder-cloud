# syntax=docker/dockerfile:1
#
# Linux-only processing-worker image for the cloud meeting recorder (Task 17).
#
# AUTHORED ONLY: this image has never been built or started. Docker is
# unavailable on the macOS worktree (ruling R3), so a Linux build, container
# start and HEALTHCHECK result are all not_run. No model weights are baked in;
# an operator mounts a manifest and local files at /models read-only.
#
# This image deliberately has no ASR engine and no fake processor. Production
# startup first refuses the fake identity provider (G1 unanswered) and exits 2
# with worker_settings_invalid. Once G1 is granted, a start without an
# injected processor exits 2 with worker_processor_not_configured rather than
# pretending to transcribe audio.
# It installs requirements-cloud.lock only and never mlx-whisper, sounddevice
# or any MLX package.

FROM python:3.13-slim-bookworm

# Required and intentionally without a default; see Dockerfile.api.
ARG FFMPEG_VERSION

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CLOUD_MODEL_CACHE=/models

RUN test -n "${FFMPEG_VERSION}" \
    || { echo >&2 "FFMPEG_VERSION build arg is required"; exit 1; }

RUN apt-get update \
    && apt-get install -y --no-install-recommends "ffmpeg=${FFMPEG_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-cloud.lock ./requirements-cloud.lock
RUN pip install --requirement requirements-cloud.lock

COPY cloud ./cloud

# Read-only model mount point, owned by root, plus a non-root user with no
# login shell. The worker shares uid 10001 with the API because both write the
# same local object tree (the objectsdata volume); its own .tmp staging dir is
# 0700, so a distinct uid could not sweep or publish there.
RUN install -d -m 0555 /models \
    && useradd --system --uid 10001 --no-create-home \
        --shell /usr/sbin/nologin cloud-worker \
    && install -d -o 10001 -g 10001 -m 0750 /var/lib/meeting-recorder

USER 10001

# --check is expected to fail until a real, measured manifest and its local
# weights are mounted. An unhealthy worker is the honest state.
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD ["python", "-m", "cloud.worker", "--check"]

CMD ["python", "-m", "cloud.worker"]
